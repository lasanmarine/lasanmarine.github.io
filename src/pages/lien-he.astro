---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/site.js';
const contacts = [
  ['Công ty', 'LASAN MARINE COMPANY LIMITED'],
  ['Địa chỉ', 'Số 03 Trần Lư, Phường Bắc Nha Trang, Tỉnh Khánh Hòa'],
  ['Hotline', '0834 310 781'],
  ['Email', 'contact@lasanmarine.vn'],
];
---

<BaseLayout title="Liên hệ | Lasan Marine" description="Trao đổi yêu cầu kỹ thuật với Lasan Marine."
  ><PageHero title="Trao đổi với đội ngũ kỹ thuật Lasan Marine" /><main>
    <section class="section">
      <div class="container contact-layout">
        <aside>
          <h2 class="section-title">Thông tin liên hệ</h2><div class="contacts">
            {
              contacts.map((x) => (
                <div>
                  <>
                    <small>{x[0]}</small>
                    <strong>{x[1]}</strong>
                  </>
                </div>
              ))
            }
          </div>
        </aside><form id="contact-form">
          <div class="fields">
            <label>
              Họ và tên *<input
                name="name"
                required
                placeholder="Nguyễn Văn A"
                autocomplete="name"
              />
            </label><label>
              Công ty<input
                name="company"
                placeholder="Tên doanh nghiệp"
                autocomplete="organization"
              />
            </label><label>
              Điện thoại *<input
                name="phone"
                type="tel"
                required
                placeholder="09xx xxx xxx"
                autocomplete="tel"
              />
            </label><label>
              Email<input
                name="email"
                type="email"
                placeholder="ten@congty.vn"
                autocomplete="email"
              />
            </label><label>
              Dịch vụ quan tâm<select name="service">
                {services.map((service) => <option>{service.name}</option>)}
              </select>
            </label><label>
              Loại phương tiện<select name="vessel">
                <option>Tàu đánh cá</option><option>Phương tiện thủy nội địa</option><option>
                  Phương tiện vận tải đường thủy
                </option>
              </select>
            </label><label class="full">
              Nội dung<textarea
                name="message"
                rows="6"
                placeholder="Mô tả ngắn về phương tiện và yêu cầu kỹ thuật"
              >
              </textarea>
            </label><label class="full file">
              Tài liệu đính kèm<input type="file" name="attachment" accept=".pdf,.dwg,.zip" /><span>
                Chọn tệp bản vẽ, hồ sơ (PDF, DWG, ZIP)
              </span>
            </label><div class="full">
              <button class="button" type="submit">Gửi yêu cầu <Icon name="arrow" /></button>
            </div>
          </div><div class="success" hidden>
            <Icon name="check" size={48} /><h2>Yêu cầu đã được ghi nhận</h2><p>
              Đây là bản giao diện mẫu. Vui lòng kết nối form với email hoặc API trước khi triển
              khai chính thức.
            </p>
          </div>
        </form>
      </div>
    </section>
  </main><script>
    const form = document.querySelector('#contact-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      form.querySelector('.fields')?.setAttribute('hidden', '');
      form.querySelector('.success')?.removeAttribute('hidden');
    });
  </script></BaseLayout
>
<style lang="scss">
  .contact-layout {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 90px;
  }
  .contacts {
    border-top: 1px solid rgba(11, 28, 75, 0.16);
    margin-top: 25px;
  }
  .contacts div {
    padding: 20px 0;
    border-bottom: 1px solid rgba(11, 28, 75, 0.16);
  }
  .contacts small,
  .contacts strong {
    display: block;
  }
  .contacts small {
    color: rgba(29, 31, 32, 0.6);
    margin-bottom: 6px;
  }
  .contacts strong {
    color: #0b1c4b;
    font-size: 18px;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .fields label {
    display: block;
    color: #0b1c4b;
    font-size: 14px;
    font-weight: 600;
  }
  .fields input,
  .fields select,
  .fields textarea {
    display: block;
    width: 100%;
    border: 1px solid rgba(11, 28, 75, 0.22);
    padding: 14px 16px;
    margin-top: 8px;
    background: white;
    color: #0b1c4b;
  }
  .full {
    grid-column: span 2;
  }
  .file {
    position: relative;
    border: 1px dashed rgba(11, 28, 75, 0.3);
    padding: 26px;
  }
  .file input {
    position: absolute;
    opacity: 0;
    inset: 0;
    height: 100%;
    cursor: pointer;
  }
  .file span {
    display: block;
    color: rgba(29, 31, 32, 0.65);
    font-weight: 400;
  }
  .success {
    border: 1px solid #0a72c8;
    background: #f4f8fd;
    padding: 50px;
  }
  .success svg {
    color: #0a72c8;
  }
  .success h2 {
    font-size: 34px;
    color: #0b1c4b;
    margin: 22px 0 12px;
  }
  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
  @media (max-width: 550px) {
    .fields {
      grid-template-columns: 1fr;
    }
    .full {
      grid-column: auto;
    }
  }
</style>
