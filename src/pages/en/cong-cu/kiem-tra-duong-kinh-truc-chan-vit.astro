---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolLayout from '@/blocks/ToolLayout.astro';
import ShaftDiameterCalculator from '@/blocks/ShaftDiameterCalculator.astro';
import '@/styles/tools.scss';
import { kiemTraDuongKinhTrucChanVit as content } from '@/data/en/kiem-tra-duong-kinh-truc-chan-vit.js';
---

<BaseLayout title={content.meta.title} description={content.meta.description} lang="en">
  <main>
    <ToolLayout navTitle={content.hero.title}>
      <ShaftDiameterCalculator
        powerLabel={content.calculator.powerLabel}
        unitLabel={content.calculator.unitLabel}
        units={content.calculator.units}
        rpmLabel={content.calculator.rpmLabel}
        ratioLabel={content.calculator.ratioLabel}
        ratioPlaceholder={content.calculator.ratioPlaceholder}
        materialLabel={content.calculator.materialLabel}
        materials={content.calculator.materials}
        submitLabel={content.calculator.submitLabel}
        resetLabel={content.calculator.resetLabel}
        resultHeaders={content.calculator.resultHeaders}
        resultRows={content.calculator.resultRows}
        note={content.calculator.note}
        formula={content.calculator.formula}
      />
    </ToolLayout>
  </main>
</BaseLayout>
