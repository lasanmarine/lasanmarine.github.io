---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import '@/styles/tools.scss';
---

<BaseLayout
  title="Power conversion | Lasan Marine"
  description="Convert power values between kW, HP, CV, and PS."
  lang="en"
>
  <PageHero
    title="Power conversion"
    description="Convert engine power between kW, HP, CV, and PS for quick technical reference."
  />
  <main>
    <section class="section">
      <div class="container tool-layout">
        <aside class="tool-intro">
          <h2 class="section-title">Engineering tools</h2>
          <p>
            Enter a power value and its original unit to obtain precise and rounded conversions.
          </p>
          <nav class="tool-links" aria-label="Engineering tools">
            <a href="/en/cong-cu/chuyen-doi-cong-suat/" aria-current="page">Power conversion</a>
            <a href="/en/cong-cu/kiem-tra-duong-kinh-truc-chan-vit/">
              Propeller shaft diameter check
            </a>
          </nav>
        </aside>
        <div class="calculator" data-power-converter>
          <form class="calculator-form" novalidate>
            <div class="calculator-fields">
              <label>
                Power value<input
                  type="number"
                  name="value"
                  min="0"
                  step="any"
                  inputmode="decimal"
                  placeholder="Example: 500"
                  required
                />
              </label>
              <label>
                Original unit<select name="unit" required>
                  <option value="">Select unit</option><option value="kW">kW</option><option
                    value="HP"
                  >
                    HP
                  </option><option value="CV">CV</option><option value="PS">PS</option>
                </select>
              </label>
            </div>
            <p class="calculator-error" data-error hidden></p>
            <div class="calculator-actions">
              <button class="button" type="submit">Convert</button><button
                class="button button--secondary"
                type="reset"
              >
                Reset
              </button>
            </div>
          </form>
          <div class="calculator-result" data-results hidden aria-live="polite">
            <h2>Conversion results</h2>
            <table class="result-table">
              <thead><tr><th>Result</th><th>Rounded</th><th>Unit</th></tr></thead><tbody>
                {
                  ['HP', 'CV', 'kW', 'PS'].map((unit) => (
                    <tr>
                      <>
                        <td data-result={unit} />
                        <td data-rounded={unit} />
                        <td>{unit}</td>
                      </>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="tool-note">
              Conventions: 1 HP = 0.7457 kW; 1 CV = 1 PS = 0.735499 kW. Results are for quick
              reference and do not replace verified engineering calculations.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-power-converter]').forEach((calculator) => {
    const form = calculator.querySelector<HTMLFormElement>('form');
    const error = calculator.querySelector<HTMLElement>('[data-error]');
    const results = calculator.querySelector<HTMLElement>('[data-results]');
    const factors: Record<string, number> = { kW: 1, HP: 0.7457, CV: 0.735499, PS: 0.735499 };
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const value = Number(data.get('value'));
      const unit = String(data.get('unit') ?? '');
      if (!Number.isFinite(value) || value <= 0 || !factors[unit]) {
        if (error) {
          error.textContent = 'Enter a power value greater than 0 and select its unit.';
          error.hidden = false;
        }
        results?.setAttribute('hidden', '');
        return;
      }
      const kw = value * factors[unit];
      const converted: Record<string, number> = {
        HP: kw / factors.HP,
        CV: kw / factors.CV,
        kW: kw,
        PS: kw / factors.PS,
      };
      Object.entries(converted).forEach(([key, result]) => {
        const exact = calculator.querySelector<HTMLElement>(`[data-result="${key}"]`);
        const rounded = calculator.querySelector<HTMLElement>(`[data-rounded="${key}"]`);
        if (exact) exact.textContent = result.toFixed(2);
        if (rounded) rounded.textContent = result.toFixed(0);
      });
      if (error) error.hidden = true;
      results?.removeAttribute('hidden');
    });
    form?.addEventListener('reset', () => {
      if (error) error.hidden = true;
      results?.setAttribute('hidden', '');
    });
  });
</script>
