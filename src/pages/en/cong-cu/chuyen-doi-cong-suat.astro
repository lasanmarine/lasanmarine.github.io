---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolLayout from '@/blocks/ToolLayout.astro';
import PowerConverterCalculator from '@/blocks/PowerConverterCalculator.astro';
import '@/styles/tools.scss';
import { chuyenDoiCongSuat as content } from '@/data/en/chuyen-doi-cong-suat.js';
---

<BaseLayout title={content.meta.title} description={content.meta.description} lang="en">
  <main>
    <ToolLayout
      navTitle={content.hero.title}
      navIntro={content.hero.description}
      navAriaLabel={content.tool.navAriaLabel}
      links={content.tool.links}
    >
      <PowerConverterCalculator
        valueLabel={content.calculator.valueLabel}
        valuePlaceholder={content.calculator.valuePlaceholder}
        unitLabel={content.calculator.unitLabel}
        unitPlaceholder={content.calculator.unitPlaceholder}
        units={content.calculator.units}
        submitLabel={content.calculator.submitLabel}
        resetLabel={content.calculator.resetLabel}
        resultsTitle={content.calculator.resultsTitle}
        resultHeaders={content.calculator.resultHeaders}
        resultUnits={content.calculator.resultUnits}
        note={content.calculator.note}
      />
    </ToolLayout>
  </main>
</BaseLayout>
