---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import ServiceShowcase from '@/components/ServiceShowcase.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CallToAction from '@/components/CallToAction.astro';
import Icon from '@/components/Icon.astro';

const categories = [
  [
    '01',
    'Fishing vessels',
    'New design, conversion, and refit solutions tailored to fishing operations.',
    '/tau_danh_ca.png',
  ],
  [
    '02',
    'Inland waterway vessels',
    'Vessel design for transport, commercial use, and inland operations.',
    '/phuong_tien_tau_thuy_noi_dia.png',
  ],
  [
    '03',
    'Waterway transport vessels',
    'Solutions tailored to cargo capacity, function, and operating conditions.',
    '/phuong_tien_van_tai_duong_thuy.png',
  ],
];
---

<BaseLayout
  title="Lasan Marine | Marine engineering"
  description="Design of fishing vessels, inland waterway vessels, and waterway transport."
  lang="en"
>
  <Fragment slot="head">
    <link rel="preload" href="/hero.png" as="image" fetchpriority="high" />
    <link
      rel="preload"
      href="/fonts/Barlow-SemiBold.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
  </Fragment>
  <main>
    <section class="technical-grid hero">
      <div class="container">
        <h1>Engineering Tomorrow's Oceans</h1>
        <p class="hero__description">
          Engineering solutions for fishing vessels, inland waterway vessels, and waterway
          transport.
        </p>
        <div class="hero__actions">
          <ButtonLink href="/en/dich-vu/">View services</ButtonLink>
          <ButtonLink href="/en/lien-he/" outline>Contact us</ButtonLink>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container split">
        <h2 class="section-title">About us</h2><div class="prose">
          <p class="lead">
            Lasan Marine specializes in vessel design, conversion, refit, and technical
            documentation.
          </p><p>
            Our engineers work from real operating requirements through principal dimensions,
            general arrangement, hull form, structure, propulsion, and stability.
          </p>
        </div>
      </div>
    </section>
    <section class="section customer-message">
      <div class="container customer-message__layout">
        <div class="customer-message__portrait">
          <img src="/ceo_huynh_le_hong_thai.png" alt="Dr. Huynh Le Hong Thai" loading="lazy" />
          <span class="customer-message__orbit" aria-hidden="true"></span>
          <span class="customer-message__mark customer-message__mark--top" aria-hidden="true">
          </span>
          <span class="customer-message__mark customer-message__mark--side" aria-hidden="true">
          </span>
          <div class="customer-message__signature">
            <strong>Dr. Huynh Le Hong Thai</strong>
            <span>Company Director</span>
          </div>
        </div>
        <div class="customer-message__content">
          <h2 class="section-title">A message to our clients</h2>
          <p class="customer-message__quote">
            Every vessel presents a distinct engineering challenge. We listen closely to real
            operating needs and work with our clients to create safe, efficient solutions built for
            long-term use.
          </p>
          <ButtonLink href="/en/lien-he/">Contact us</ButtonLink>
        </div>
      </div>
    </section>
    <section class="vehicle-categories" data-vehicle-categories>
      <div class="vehicle-categories__sticky">
        <div class="vehicle-categories__background" aria-hidden="true">
          {
            categories.map((category, index) => (
              <div
                class:list={{ active: index === 0 }}
                data-category-background={index}
                style={`background-image: linear-gradient(90deg, rgba(7, 18, 51, 0.88), rgba(7, 18, 51, 0.52)), url('${category[3]}')`}
              />
            ))
          }
        </div>
        <div class="container vehicle-categories__content">
          <div class="vehicle-categories__heading">
            <h2 class="section-title">Vessel types</h2><p class="lead intro">
              Scroll to explore the vessel categories designed by Lasan Marine.
            </p>
          </div>
          <div class="categories-viewport">
            <div class="categories" data-category-track>
              {
                categories.map((category, index) => (
                  <a
                    href="/en/dich-vu/"
                    class:list={{ active: index === 0 }}
                    data-category-card={index}
                  >
                    <div>
                      <h3>{category[1]}</h3>
                      <p>{category[2]}</p>
                    </div>
                    <span>
                      <em>Explore this category</em>
                      <Icon name="arrow" size={32} />
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
          <div class="categories-progress" aria-hidden="true"><i data-category-progress></i></div>
        </div>
      </div>
    </section>
    <section class="section service-section">
      <div class="container service-section__container">
        <ServiceShowcase lang="en" />
      </div>
    </section>
    <section class="section technical-grid process">
      <div class="container"><h2>Project delivery process</h2><ProcessSteps dark lang="en" /></div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">Featured projects</h2><ButtonLink href="/en/du-an/"
            >View all projects</ButtonLink
          >
        </div><ProjectGrid limit={3} lang="en" />
      </div>
    </section>
    <CallToAction
      title="Do you have a vessel that needs design or conversion?"
      text="Share your requirements with our engineering team."
      href="/en/lien-he/"
      label="Contact us"
    />
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-vehicle-categories]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-category-track]');
    const cards = section.querySelectorAll<HTMLElement>('[data-category-card]');
    const backgrounds = section.querySelectorAll<HTMLElement>('[data-category-background]');
    const progressBar = section.querySelector<HTMLElement>('[data-category-progress]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let frame = 0;
    let targetProgress = 0;
    let renderedProgress = 0;
    let previousTime = performance.now();

    const getProgress = () => {
      const bounds = section.getBoundingClientRect();
      const scrollRange = section.offsetHeight - window.innerHeight;
      return Math.min(1, Math.max(0, -bounds.top / scrollRange));
    };

    const render = (time: number) => {
      if (!track || !cards.length) return;

      const delta = Math.min(64, time - previousTime);
      const smoothing = reduceMotion ? 1 : 1 - Math.exp(-delta / 140);
      renderedProgress += (targetProgress - renderedProgress) * smoothing;
      previousTime = time;

      if (Math.abs(targetProgress - renderedProgress) < 0.0001) {
        renderedProgress = targetProgress;
      }

      const maxTranslate = track.scrollWidth;
      const activeIndex = Math.min(cards.length - 1, Math.floor(renderedProgress * cards.length));

      track.style.transform = `translate3d(${-renderedProgress * maxTranslate}px, 0, 0)`;
      progressBar?.style.setProperty('transform', `scaleX(${renderedProgress})`);
      cards.forEach((card, index) => card.classList.toggle('active', index === activeIndex));
      backgrounds.forEach((background, index) =>
        background.classList.toggle('active', index === activeIndex),
      );

      if (renderedProgress !== targetProgress) {
        frame = window.requestAnimationFrame(render);
      } else {
        frame = 0;
      }
    };

    const requestUpdate = () => {
      targetProgress = getProgress();
      if (!frame) {
        previousTime = performance.now();
        frame = window.requestAnimationFrame(render);
      }
    };

    targetProgress = getProgress();
    renderedProgress = targetProgress;
    render(performance.now());
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  });
</script>

<style lang="scss">
  .hero {
    position: relative;
    color: white;
    min-height: calc(100vh - 84px);
    display: flex;
    align-items: center;
    background-image:
      linear-gradient(
        90deg,
        rgba(7, 18, 51, 0.94) 0%,
        rgba(7, 18, 51, 0.78) 48%,
        rgba(7, 18, 51, 0.38) 100%
      ),
      url('/hero.png');
    background-position: center;
    background-size: cover;
  }
  .hero .container {
    padding-block: 96px;
  }
  .hero h1 {
    font-size: clamp(3.2rem, 7vw, 6.5rem);
    line-height: 0.98;
    font-weight: 600;
    max-width: 1050px;
    margin-bottom: 28px;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .hero__description {
    max-width: 720px;
    margin-bottom: 40px;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.7;
  }
  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .split {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 80px;
  }
  .intro {
    max-width: 720px;
    margin: 12px 0 0;
  }
  .customer-message {
    background: #f5f5f0;
  }
  .customer-message__layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(48px, 9vw, 140px);
    align-items: center;
  }
  .customer-message__portrait {
    position: relative;
    width: min(78%, 320px);
    aspect-ratio: 1;
    margin: 44px auto;
  }
  .customer-message__portrait img {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    border: 8px solid #fff;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
  }
  .customer-message__orbit {
    position: absolute;
    inset: -28px;
    border: 1px solid rgba(11, 28, 75, 0.28);
    border-radius: 50%;
  }
  .customer-message__orbit::before,
  .customer-message__orbit::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: #0a72c8;
  }
  .customer-message__orbit::before {
    top: 18%;
    right: 2%;
    width: 10px;
    height: 10px;
  }
  .customer-message__orbit::after {
    bottom: 10%;
    left: 10%;
    width: 6px;
    height: 6px;
  }
  .customer-message__mark {
    position: absolute;
    background: #0b1c4b;
  }
  .customer-message__mark::after {
    content: '';
    position: absolute;
    background: inherit;
  }
  .customer-message__mark--top {
    top: -44px;
    left: 50%;
    width: 1px;
    height: 32px;
  }
  .customer-message__mark--top::after {
    top: 15px;
    left: -6px;
    width: 13px;
    height: 1px;
  }
  .customer-message__mark--side {
    top: 50%;
    right: -44px;
    width: 32px;
    height: 1px;
  }
  .customer-message__mark--side::after {
    top: -6px;
    left: 15px;
    width: 1px;
    height: 13px;
  }
  .customer-message__content {
    max-width: 700px;
  }
  .customer-message__quote {
    max-width: 650px;
    margin: 28px 0 36px;
    color: #0b1c4b;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.55;
  }
  .customer-message__signature {
    position: absolute;
    z-index: 4;
    top: 70%;
    left: 68%;
    width: max-content;
    max-width: 440px;
    padding: 14px 20px 15px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 24px rgba(11, 28, 75, 0.1);
    color: #0b1c4b;
    text-align: left;
  }
  .customer-message__signature strong,
  .customer-message__signature span {
    display: block;
  }
  .customer-message__signature strong {
    font-size: 1.08rem;
  }
  .customer-message__signature span {
    color: rgba(29, 31, 32, 0.62);
  }
  .vehicle-categories {
    position: relative;
    height: 300svh;
    background: #071233;
  }
  .vehicle-categories__sticky {
    position: sticky;
    top: 0;
    isolation: isolate;
    height: 100svh;
    overflow: hidden;
    color: white;
  }
  .vehicle-categories__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: #071233;
  }
  .vehicle-categories__background > div {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-position: center;
    background-size: cover;
    transform: scale(1.02);
    transition:
      opacity 650ms ease,
      transform 1200ms ease;
  }
  .vehicle-categories__background > div.active {
    opacity: 1;
    transform: scale(1);
  }
  .vehicle-categories__content {
    height: 100%;
    padding-block: max(110px, 12svh) 54px;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .vehicle-categories__heading {
    position: relative;
    z-index: 1;
  }
  .vehicle-categories .section-title,
  .vehicle-categories .intro {
    color: white;
  }
  .vehicle-categories .intro {
    color: rgba(255, 255, 255, 0.72);
  }
  .categories-viewport {
    min-width: 0;
    display: flex;
    align-items: center;
    overflow: visible;
  }
  .categories {
    display: flex;
    gap: 28px;
    width: max-content;
    will-change: transform;
  }
  .categories a {
    position: relative;
    flex: 0 0 clamp(320px, 55vw, 720px);
    min-height: 290px;
    display: flex;
    align-items: flex-end;
    gap: 28px;
    padding: 34px;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(7, 18, 51, 0.52);
    text-decoration: none;
    opacity: 0.55;
    transition:
      opacity 300ms ease,
      background-color 300ms ease,
      border-color 300ms ease;
  }
  .categories a.active {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.72);
    background: rgba(7, 18, 51, 0.76);
  }
  .categories h3 {
    max-width: 580px;
    margin: 0 0 18px;
    color: white;
    font-size: clamp(1.75rem, 3vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .categories p {
    max-width: 560px;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.05rem;
  }
  .categories span {
    position: absolute;
    top: 34px;
    right: 34px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
  }
  .categories span em {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    color: white;
    font-size: 14px;
    font-style: normal;
    white-space: nowrap;
    transition:
      max-width 300ms ease,
      opacity 200ms ease;
  }
  .categories a.active span em {
    max-width: 170px;
    opacity: 1;
  }
  .categories-progress {
    height: 2px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.25);
  }
  .categories-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: white;
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }
  .space {
    margin-bottom: 48px;
  }
  .service-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-block: 0;
    background: #0b1c4b;
  }
  .service-section__container {
    width: 100%;
    max-width: none;
    margin-inline: 0;
  }
  .process {
    color: white;
    scroll-margin-top: 84px;
  }
  .process h2 {
    font-size: 40px;
    margin-bottom: 60px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 48px;
    gap: 30px;
  }
  @media (max-width: 800px) {
    .split {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .section-head {
      align-items: start;
      flex-direction: column;
    }
    .customer-message__layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .customer-message__portrait {
      width: min(70vw, 260px);
      margin: 32px 0;
    }
    .customer-message__content {
      text-align: left;
    }
    .customer-message__signature {
      top: 76%;
      left: 0;
      max-width: calc(100vw - 56px);
      padding: 12px 16px 13px;
      text-align: left;
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 620px;
    }
    .hero h1 {
      font-size: 3.25rem;
    }
    .vehicle-categories__content {
      padding-block: 96px 32px;
    }
    .categories {
      gap: 16px;
    }
    .categories a {
      flex-basis: calc(100vw - 64px);
      min-height: 300px;
      padding: 26px;
    }
    .categories span {
      top: 26px;
      right: 26px;
    }
    .categories span em {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vehicle-categories__background > div,
    .categories a {
      transition: none;
    }
  }
</style>
