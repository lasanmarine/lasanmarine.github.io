---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import BlogList from '@/blocks/BlogList.astro';
import { baiViet as content } from '@/data/en/bai-viet.js';
---

<BaseLayout title={content.meta.title} description={content.meta.description} lang="en">
  <PageHero title={content.hero.title} description={content.hero.description} />
  <main>
    <BlogList
      featured={content.featured}
      posts={content.posts}
      imageLabel={content.imageLabel}
      readLabel={content.readLabel}
    />
    <CallToAction title={content.cta.title} href={content.cta.href} label={content.cta.label} />
  </main>
</BaseLayout>
