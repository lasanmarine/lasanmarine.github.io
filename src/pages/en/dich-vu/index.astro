---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import ServiceGrid from '@/blocks/ServiceGrid.astro';
import ProcessSteps from '@/blocks/ProcessSteps.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import { dichVu as content } from '@/data/en/dich-vu.js';
import { getSiteData } from '@/data/site.js';

const base = '/en';
const { services, steps } = getSiteData('en');
---

<BaseLayout title={content.meta.title} description={content.meta.description} lang="en"
  ><PageHero title={content.hero.title} description={content.hero.description} /><main>
    <section class="section">
      <div class="container"
        ><ServiceGrid base={base} services={services} detailsLabel={content.services.detailsLabel} /></div
      >
    </section><section class="section section--pale">
      <div class="container">
        <h2 class="section-title">{content.process.title}</h2><div class="mt-15">
          <ProcessSteps steps={steps} />
        </div>
      </div>
    </section><CallToAction
      title={content.cta.title}
      href={content.cta.href}
      label={content.cta.label}
    />
  </main></BaseLayout
>
