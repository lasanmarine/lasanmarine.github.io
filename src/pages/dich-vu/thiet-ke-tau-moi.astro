---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import ProcessSteps from '@/blocks/ProcessSteps.astro';
import ProjectGrid from '@/blocks/ProjectGrid.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import { thietKeTauMoi as content } from '@/data/vi/thiet-ke-tau-moi.js';
import { getSiteData } from '@/data/site.js';

const base = '';
const { steps, projects } = getSiteData('vi');
---

<BaseLayout title={content.meta.title} description={content.meta.description}
  ><PageHero title={content.hero.title} description={content.hero.description} /><main>
    <section class="section">
      <div
        class="container grid grid-cols-[380px_1fr] gap-[70px] max-[750px]:grid-cols-1 max-[750px]:gap-5"
      >
        <h2 class="section-title">{content.overview.title}</h2><p class="lead muted">
          {content.overview.text}
        </p>
      </div>
    </section><section class="section section--divided">
      <div class="container">
        <h2 class="section-title">{content.scope.title}</h2><div
          class="mt-[50px] grid grid-cols-4 border border-navy/15 max-[750px]:grid-cols-2 max-[450px]:grid-cols-1"
        >
          {
            content.scope.items.map((x, i) => (
              <div class="flex gap-4 border border-navy/10 p-7">
                <b class="text-marine">{String(i + 1).padStart(2, '0')}</b>
                <span>{x}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section><section class="section">
      <div class="container">
        <h2 class="section-title section-title--marked">{content.process.title}</h2><div
          class="mt-[55px]"
        >
          <ProcessSteps steps={steps} />
        </div>
      </div>
    </section><section class="section band-navy text-white">
      <div class="container">
        <h2 class="text-[40px]">{content.deliverables.title}</h2><p class="text-white/70">
          {content.deliverables.text}
        </p><div class="mt-[35px] flex flex-wrap gap-px">
          {
            content.deliverables.items.map((x) => (
              <span class="border border-white/25 px-[22px] py-[18px]">{x}</span>
            ))
          }
        </div>
      </div>
    </section><section class="section">
      <div class="container">
        <h2 class="section-title mt-[55px]">{content.projects.title}</h2><ProjectGrid
          base={base}
          projects={projects}
          imageLabel={content.projects.imageLabel}
          limit={3}
        />
      </div>
    </section><CallToAction title={content.cta.title} label={content.cta.label} />
  </main></BaseLayout
>
