---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CallToAction from '@/components/CallToAction.astro';
const scope = [
  'Phân tích yêu cầu khai thác',
  'Xác định thông số chính',
  'Thiết kế bố trí chung',
  'Thiết kế tuyến hình',
  'Thiết kế kết cấu',
  'Bố trí máy và hệ động lực',
  'Tính toán ổn định',
  'Hoàn thiện hồ sơ kỹ thuật',
];
const outputs = [
  'General Arrangement',
  'Lines Plan',
  'Construction Drawings',
  'Machinery Arrangement',
  'Stability Calculation',
  'Technical Specification',
  'Hồ sơ kỹ thuật liên quan',
];
---

<BaseLayout
  title="Thiết kế tàu mới | Lasan Marine"
  description="Dịch vụ thiết kế tàu mới từ phương án đến hồ sơ kỹ thuật."
  ><PageHero
    title="Thiết kế tàu mới"
    description="Phát triển phương án tàu từ yêu cầu khai thác ban đầu đến bộ hồ sơ kỹ thuật hoàn chỉnh."
  /><main>
    <section class="section">
      <div class="container two">
        <h2 class="section-title">Tổng quan dịch vụ</h2><p class="lead muted">
          Dịch vụ phù hợp với chủ tàu, doanh nghiệp khai thác và đơn vị đóng tàu đang cần phát triển
          phương tiện theo mục đích sử dụng cụ thể.
        </p>
      </div>
    </section><section class="section section--pale">
      <div class="container">
        <h2 class="section-title">Phạm vi công việc</h2><div class="matrix">
          {
            scope.map((x, i) => (
              <div>
                <>
                  <b>{String(i + 1).padStart(2, '0')}</b>
                  <span>{x}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section><section class="section">
      <div class="container">
        <h2 class="section-title">Quy trình thực hiện</h2><div class="space"><ProcessSteps /></div>
      </div>
    </section><section class="section output technical-grid">
      <div class="container">
        <h2>Đầu ra bàn giao</h2><p>
          Bộ tài liệu được tổ chức theo hạng mục, phục vụ thi công và kiểm tra phân cấp.
        </p><div>{outputs.map((x) => <span>{x}</span>)}</div>
      </div>
    </section><section class="section">
      <div class="container">
        <h2 class="section-title space">Dự án liên quan</h2><ProjectGrid limit={3} />
      </div>
    </section><CallToAction
      title="Trao đổi yêu cầu kỹ thuật với Lasan Marine"
      label="Gửi yêu cầu"
    />
  </main></BaseLayout
>
<style lang="scss">
  .two {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 70px;
  }
  .matrix {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 50px;
    border: 1px solid rgba(11, 28, 75, 0.15);
  }
  .matrix div {
    padding: 28px;
    border: 1px solid rgba(11, 28, 75, 0.1);
    display: flex;
    gap: 16px;
  }
  .matrix b {
    color: #0a72c8;
  }
  .space {
    margin-top: 55px;
  }
  .output {
    color: white;
  }
  .output h2 {
    font-size: 40px;
  }
  .output p {
    color: rgba(255, 255, 255, 0.7);
  }
  .output .container > div {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin-top: 35px;
  }
  .output span {
    padding: 18px 22px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  @media (max-width: 750px) {
    .two {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .matrix {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 450px) {
    .matrix {
      grid-template-columns: 1fr;
    }
  }
</style>
