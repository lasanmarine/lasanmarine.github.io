---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CallToAction from '@/components/CallToAction.astro';
---

<BaseLayout
  title="Dịch vụ | Lasan Marine"
  description="Dịch vụ thiết kế và tư vấn kỹ thuật phương tiện thủy."
  ><PageHero
    title="Dịch vụ thiết kế & tư vấn kỹ thuật"
    description="Mười nhóm dịch vụ bao trùm vòng đời kỹ thuật của phương tiện: thiết kế mới, chuyển hoán, hoán cải và hồ sơ phân cấp."
  /><main>
    <section class="section"><div class="container"><ServiceGrid /></div></section><section
      class="section section--pale"
    >
      <div class="container">
        <h2 class="section-title">Quy trình làm việc</h2><div class="gap"><ProcessSteps /></div>
      </div>
    </section><CallToAction title="Trao đổi yêu cầu kỹ thuật với Lasan Marine" />
  </main></BaseLayout
><style>
  .gap {
    margin-top: 60px;
  }
</style>
