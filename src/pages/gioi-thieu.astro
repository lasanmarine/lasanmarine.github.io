---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import '@/styles/components/GioiThieuPage.scss';
import { gioiThieu as content } from '@/data/vi/gioi-thieu.js';
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <PageHero title={content.hero.title} description={content.hero.description} />
  <main>
    <section class="section introduction">
      <div class="container introduction__layout">
        <div class="introduction__portrait">
          <img src="/ceo_huynh_le_hong_thai.webp" alt={content.message.name} />
          <span class="introduction__orbit" aria-hidden="true"></span>
          <span class="introduction__mark introduction__mark--top" aria-hidden="true"></span>
          <span class="introduction__mark introduction__mark--side" aria-hidden="true"></span>
          <div>
            <strong>{content.message.name}</strong>
            <span>{content.message.role}</span>
          </div>
        </div>
        <div class="introduction__message">
          <h2 class="section-title">{content.message.title}</h2>
          <div class="prose lead-copy">
            {content.message.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <strong class="introduction__closing">{content.message.closing}</strong>
        </div>
      </div>
    </section>

    <section class="company-stats" aria-label={content.statsLabel}>
      <div class="container">
        {
          content.stats.map((item) => (
            <div>
              <strong>{item[0]}</strong>
              <span>{item[1]}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section company-profile">
      <div class="container company-profile__layout">
        <aside>
          <h2 class="section-title">{content.profile.title}</h2>
        </aside>
        <div class="company-profile__content">
          <article>
            <h3>{content.profile.quality.title}</h3>
            <p class="prose">{content.profile.quality.body}</p>
            <div class="principles">
              {content.profile.principles.map((principle) => <p>{principle}</p>)}
            </div>
          </article>

          <article>
            <h3>{content.profile.legalTitle}</h3>
            <dl class="legal">
              {
                content.profile.legal.map((item) => (
                  <div>
                    <dt>{item[0]}</dt>
                    <dd>{item[1]}</dd>
                  </div>
                ))
              }
            </dl>
          </article>

          <article class="capability">
            <h3>{content.profile.capability.title}</h3>
            <p class="prose">{content.profile.capability.body}</p>
          </article>

          <blockquote>
            <p>{content.profile.quote.text}</p>
            <span>{content.profile.quote.attribution}</span>
          </blockquote>
        </div>
      </div>
    </section>
    <CallToAction title={content.ctaTitle} />
  </main>
</BaseLayout>
