---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import ProjectGrid from '@/blocks/ProjectGrid.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import { duAn as content } from '@/data/vi/du-an.js';
import { getSiteData } from '@/data/site.js';

const base = '';
const { projects } = getSiteData('vi');
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <PageHero title={content.hero.title} description={content.hero.description} />
  <main>
    <section class="section">
      <div class="container">
        <div class="mb-12 flex overflow-auto border-b border-navy/16">
          {
            content.filters.map((label, index) => (
              <button
                class:list={[
                  'shrink-0 border-0 border-b-2 border-transparent px-6 pt-3.5 pb-4 whitespace-nowrap text-ink/60',
                  { 'border-marine font-semibold text-marine': index === 0 },
                ]}
                data-filter={label}
              >
                {label}
              </button>
            ))
          }
        </div>
        <ProjectGrid base={base} projects={projects} imageLabel={content.imageLabel} />
      </div>
    </section>
    <CallToAction title={content.ctaTitle} />
  </main>
</BaseLayout>

<script>
  import { initProjectFilter } from '@/scripts/project-filter';
  initProjectFilter('Tất cả');
</script>
