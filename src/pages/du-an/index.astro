---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CallToAction from '@/components/CallToAction.astro';
const filters = ['Tất cả', 'Thiết kế mới', 'Chuyển hoán', 'Hoán cải', 'Hồ sơ kỹ thuật'];
---

<BaseLayout
  title="Dự án | Lasan Marine"
  description="Các dự án thiết kế và chuyển hoán phương tiện thủy."
  ><PageHero
    title="Dự án"
    description="Một số phương tiện Lasan Marine đã thiết kế, chuyển hoán và hoàn thiện hồ sơ kỹ thuật."
  /><main>
    <section class="section">
      <div class="container">
        <div class="filters">
          {
            filters.map((x, i) => (
              <button class:list={{ active: i === 0 }} data-filter={x}>
                {x}
              </button>
            ))
          }
        </div><ProjectGrid />
      </div>
    </section><CallToAction title="Bạn đang có một phương tiện cần thiết kế hoặc cải tạo?" />
  </main><script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.project');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        cards.forEach((c) => {
          c.hidden = b.dataset.filter !== 'Tất cả' && c.dataset.group !== b.dataset.filter;
        });
      }),
    );
  </script></BaseLayout
><style lang="scss">
  .filters {
    display: flex;
    overflow: auto;
    border-bottom: 1px solid rgba(11, 28, 75, 0.16);
    margin-bottom: 48px;
  }
  .filters button {
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 14px 24px 16px;
    color: rgba(29, 31, 32, 0.6);
    white-space: nowrap;
    cursor: pointer;
  }
  .filters button.active {
    color: #0a72c8;
    border-color: #0a72c8;
    font-weight: 600;
  }
</style>
