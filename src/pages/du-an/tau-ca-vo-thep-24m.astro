---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import Blueprint from '@/components/Blueprint.astro';
import ProjectGrid from '@/blocks/ProjectGrid.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import { tauCaVoThep24m as content } from '@/data/vi/tau-ca-vo-thep-24m.js';
import { getSiteData } from '@/data/site.js';

const base = '';
const { projects } = getSiteData('vi');
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <PageHero title={content.hero.title} />
  <main>
    <section class="section">
      <div class="container">
        <Blueprint
          class="placeholder h-[440px] max-[750px]:h-[280px]"
          label={content.hero.imageLabel}
        />
        <div class="mt-[55px] grid grid-cols-6 border border-navy/15 max-[750px]:grid-cols-2">
          {
            content.facts.map(([label, value]) => (
              <div class="border-r border-navy/15 p-[22px]">
                <small class="mb-[7px] block text-marine">{label}</small>
                <strong class="block">{value}</strong>
              </div>
            ))
          }
        </div>
        <div
          class="mt-20 grid grid-cols-2 gap-[70px] max-[750px]:grid-cols-1 max-[750px]:gap-[30px]"
        >
          <div>
            <h2 class="section-title">{content.story.challenge.title}</h2>
            <p class="leading-[1.8] text-ink/75">{content.story.challenge.text}</p>
          </div>
          <div>
            <h2 class="section-title">{content.story.solution.title}</h2>
            <p class="leading-[1.8] text-ink/75">{content.story.solution.text}</p>
          </div>
        </div>
      </div>
    </section>
    <section class="section section--divided">
      <div class="container">
        <h2 class="section-title">{content.scope.title}</h2>
        <div class="mt-[45px] grid grid-cols-4 max-[750px]:grid-cols-2">
          {
            content.scope.items.map((item) => (
              <span class="border border-navy/12 p-6">✓ {item}</span>
            ))
          }
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <h2 class="section-title mb-12">{content.related.title}</h2>
        <ProjectGrid
          base={base}
          projects={projects}
          imageLabel={content.related.imageLabel}
          limit={3}
        />
      </div>
    </section>
    <CallToAction title={content.ctaTitle} />
  </main>
</BaseLayout>
