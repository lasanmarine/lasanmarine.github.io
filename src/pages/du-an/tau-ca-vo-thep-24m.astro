---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Blueprint from '@/components/Blueprint.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import CallToAction from '@/components/CallToAction.astro';
const facts = [
  ['Loại phương tiện', 'Tàu đánh cá'],
  ['Dịch vụ', 'Thiết kế tàu mới'],
  ['Chiều dài', '24 m'],
  ['Chiều rộng', '6,8 m'],
  ['Công suất', '450 CV'],
  ['Năm', '2026'],
];
const scope = [
  'Bố trí chung',
  'Tuyến hình',
  'Kết cấu thân tàu',
  'Bố trí máy',
  'Hệ trục và chân vịt',
  'Tính toán ổn định',
  'Thông báo ổn định',
  'Hồ sơ phân cấp',
];
---

<BaseLayout
  title="Tàu cá vỏ thép 24m | Lasan Marine"
  description="Dự án thiết kế tàu cá vỏ thép 24m."
  ><PageHero title="Thiết kế tàu cá vỏ thép 24m" /><main>
    <section class="section">
      <div class="container">
        <Blueprint class="placeholder hero-img" label="Ảnh dự án khổ lớn" /><div class="facts">
          {
            facts.map((x) => (
              <div>
                <>
                  <small>{x[0]}</small>
                  <strong>{x[1]}</strong>
                </>
              </div>
            ))
          }
        </div><div class="story">
          <div>
            <h2 class="section-title">Bài toán</h2><p>
              Chủ tàu cần một phương tiện vỏ thép khai thác xa bờ, tăng sức chứa hầm bảo quản, đồng
              thời đáp ứng yêu cầu ổn định và an toàn.
            </p>
          </div><div>
            <h2 class="section-title">Giải pháp</h2><p>
              Lasan Marine xác định lại thông số chính, thiết kế tuyến hình và bố trí chung tối ưu
              thể tích hầm, kết hợp tính toán kết cấu và ổn định.
            </p>
          </div>
        </div>
      </div>
    </section><section class="section section--pale">
      <div class="container">
        <h2 class="section-title">Phạm vi thiết kế</h2><div class="scope">
          {scope.map((x) => <span>✓ {x}</span>)}
        </div>
      </div>
    </section><section class="section">
      <div class="container">
        <h2 class="section-title space">Dự án liên quan</h2><ProjectGrid limit={3} />
      </div>
    </section><CallToAction title="Trao đổi yêu cầu kỹ thuật với Lasan Marine" />
  </main></BaseLayout
><style lang="scss">
  .hero-img {
    height: 440px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid rgba(11, 28, 75, 0.15);
    margin-top: 55px;
  }
  .facts div {
    padding: 22px;
    border-right: 1px solid rgba(11, 28, 75, 0.15);
  }
  .facts small,
  .facts strong {
    display: block;
  }
  .facts small {
    color: #0a72c8;
    margin-bottom: 7px;
  }
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    margin-top: 80px;
  }
  .story p {
    line-height: 1.8;
    color: rgba(29, 31, 32, 0.75);
  }
  .scope {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 45px;
  }
  .scope span {
    padding: 24px;
    border: 1px solid rgba(11, 28, 75, 0.12);
  }
  .space {
    margin-bottom: 48px;
  }
  @media (max-width: 750px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .story {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .scope {
      grid-template-columns: 1fr 1fr;
    }
    .hero-img {
      height: 280px;
    }
  }
</style>
