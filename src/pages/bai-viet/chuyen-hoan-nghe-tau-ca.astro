---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/blocks/PageHero.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import BlogArticle from '@/blocks/BlogArticle.astro';
import { chuyenHoanNgheTauCa as content } from '@/data/vi/chuyen-hoan-nghe-tau-ca.js';
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <PageHero title={content.hero.title} description={content.hero.description} />
  <main>
    <BlogArticle lead={content.lead} sections={content.sections} />
    <CallToAction title={content.cta.title} />
  </main>
</BaseLayout>
