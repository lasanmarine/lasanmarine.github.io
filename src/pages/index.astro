---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ButtonLink.astro';
import Icon from '@/components/Icon.astro';
import ServiceShowcase from '@/blocks/ServiceShowcase.astro';
import ProcessSteps from '@/blocks/ProcessSteps.astro';
import ProjectGrid from '@/blocks/ProjectGrid.astro';
import CallToAction from '@/blocks/CallToAction.astro';
import '@/styles/components/HomePage.scss';
import { home } from '@/data/vi/home.js';
import { getSiteData } from '@/data/site.js';

const base = '';
const { services, steps, projects } = getSiteData('vi');
const backgrounds = Array.from({ length: 10 }, (_, i) => `/ser${i + 1}.webp`);
---

<BaseLayout title={home.meta.title} description={home.meta.description}>
  <Fragment slot="head">
    <link rel="preload" href="/hero.webp" as="image" fetchpriority="high" />
  </Fragment>
  <main>
    <section class="technical-grid hero">
      <div class="container py-24">
        <h1>{home.hero.title}</h1>
        <p class="hero__description">{home.hero.description}</p>
        <div class="flex flex-wrap gap-3.5">
          <ButtonLink href={home.hero.ctaPrimary.href}>{home.hero.ctaPrimary.label}</ButtonLink>
          <ButtonLink href={home.hero.ctaSecondary.href} outline>
            {home.hero.ctaSecondary.label}
          </ButtonLink>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container grid grid-cols-[400px_1fr] gap-20 max-[800px]:grid-cols-1 max-[800px]:gap-6">
        <h2 class="section-title">{home.about.title}</h2>
        <div class="prose">
          <p class="lead">{home.about.lead}</p>
          <p>{home.about.body}</p>
        </div>
      </div>
    </section>
    <section class="section customer-message">
      <div class="container customer-message__layout">
        <div class="customer-message__portrait">
          <img src="/ceo_huynh_le_hong_thai.webp" alt={home.customerMessage.name} loading="lazy" />
          <span class="customer-message__orbit" aria-hidden="true"></span>
          <span class="customer-message__mark customer-message__mark--top" aria-hidden="true">
          </span>
          <span class="customer-message__mark customer-message__mark--side" aria-hidden="true">
          </span>
          <div class="customer-message__signature">
            <strong>{home.customerMessage.name}</strong>
            <span>{home.customerMessage.role}</span>
          </div>
        </div>
        <div class="customer-message__content">
          <h2 class="section-title">{home.customerMessage.title}</h2>
          <p class="customer-message__quote">{home.customerMessage.quote}</p>
          <ButtonLink href="/lien-he/">{home.customerMessage.ctaLabel}</ButtonLink>
        </div>
      </div>
    </section>
    <section class="vehicle-categories" data-vehicle-categories>
      <div class="vehicle-categories__sticky">
        <div class="vehicle-categories__background" aria-hidden="true">
          {
            home.categories.items.map((category, index) => (
              <div
                class:list={{ active: index === 0 }}
                data-category-background={index}
                style={`background-image: linear-gradient(90deg, rgba(7, 18, 51, 0.88), rgba(7, 18, 51, 0.52)), url('${category.image}')`}
              />
            ))
          }
        </div>
        <div class="container vehicle-categories__content">
          <div class="vehicle-categories__heading">
            <h2 class="section-title">{home.categories.title}</h2>
            <p class="lead intro max-w-[720px] mt-3">{home.categories.intro}</p>
          </div>
          <div class="categories-viewport">
            <div class="categories" data-category-track>
              {
                home.categories.items.map((category, index) => (
                  <a
                    href="/dich-vu/"
                    class:list={{ active: index === 0 }}
                    data-category-card={index}
                  >
                    <div>
                      <h3>{category.title}</h3>
                      <p>{category.text}</p>
                    </div>
                    <span>
                      <em>{home.categories.cardCta}</em>
                      <Icon name="arrow" size={32} />
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
          <div class="categories-progress" aria-hidden="true"><i data-category-progress></i></div>
        </div>
      </div>
    </section>
    <section class="section w-full! bg-navy py-0!">
      <div class="container w-full! max-w-none! mx-0!">
        <ServiceShowcase
          base={base}
          sectionTitle={home.services.sectionTitle}
          detailsLabel={home.services.detailsLabel}
          services={services}
          backgrounds={backgrounds}
        />
      </div>
    </section>
    <section class="section technical-grid text-white scroll-mt-21">
      <div class="container">
        <h2 class="text-[40px] mb-15">{home.process.title}</h2>
        <ProcessSteps steps={steps} dark />
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="mb-12 flex items-end justify-between gap-[30px] max-[800px]:flex-col max-[800px]:items-start">
          <h2 class="section-title">{home.projects.title}</h2>
          <ButtonLink href="/du-an/">{home.projects.cta}</ButtonLink>
        </div>
        <ProjectGrid base={base} projects={projects} imageLabel={home.projects.imageLabel} limit={3} />
      </div>
    </section>
    <CallToAction title={home.cta.title} text={home.cta.text} />
  </main>
</BaseLayout>

<script>
  import { initVehicleCategories } from '@/scripts/vehicle-categories';
  initVehicleCategories();
</script>
