---
import Icon from './Icon.astro';
const { lang = 'vi' } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const labels =
  lang === 'en'
    ? ['Home', 'About', 'Services', 'Projects', 'Insights']
    : ['Trang chủ', 'Giới thiệu', 'Dịch vụ', 'Dự án', 'Bài viết'];
const paths = ['/', '/gioi-thieu/', '/dich-vu/', '/du-an/', '/bai-viet/'];
const links = paths.map((path, index) => [labels[index], `${base}${path}`]);
const contactLabel = lang === 'en' ? 'Contact us' : 'Liên hệ chúng tôi';
const switchHref =
  lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : `/en${Astro.url.pathname}`;
---

<header class="header">
  <div class="container header__inner">
    <a href={`${base}/`} class="brand">
      <img src="/logo-lasan.svg" width="250" height="35" alt="Lasan Marine" />
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span><span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main navigation">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <div class="nav-tools">
        <a href={`${base}/cong-cu/chuyen-doi-cong-suat/`}>
          {lang === 'en' ? 'Tools' : 'Công cụ'}
        </a>
        <div class="nav-tools__menu">
          <a href={`${base}/cong-cu/chuyen-doi-cong-suat/`}>
            {lang === 'en' ? 'Power conversion' : 'Chuyển đổi công suất'}
          </a>
          <a href={`${base}/cong-cu/kiem-tra-duong-kinh-truc-chan-vit/`}>
            {lang === 'en' ? 'Propeller shaft diameter check' : 'Kiểm tra đường kính trục chân vịt'}
          </a>
        </div>
      </div>
      <a href={switchHref} class="language" hreflang={lang === 'en' ? 'vi' : 'en'}>
        {lang === 'en' ? 'VI' : 'EN'}
      </a>
      <a href={`${base}/lien-he/`} class="contact">
        {contactLabel}
        <Icon name="arrow" size={18} />
      </a>
    </nav>
    <button class="nav-backdrop" type="button" tabindex="-1" aria-hidden="true"></button>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const backdrop = document.querySelector<HTMLElement>('.nav-backdrop');

  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    backdrop?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-locked', open);
  };

  button?.addEventListener('click', () => {
    setOpen(button.getAttribute('aria-expanded') !== 'true');
  });
  backdrop?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
<style lang="scss">
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid rgba(11, 28, 75, 0.12);
  }
  .header__inner {
    height: 84px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    flex: none;
  }
  .brand img {
    width: 250px;
    height: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-left: auto;
    font-size: 14px;
  }
  .nav > a {
    position: relative;
    text-decoration: none;
    white-space: nowrap;
    color: #0b1c4b;
  }
  .nav-tools {
    position: relative;
  }
  .nav-tools > a {
    color: #0b1c4b;
    text-decoration: none;
  }
  .nav-tools__menu {
    position: absolute;
    top: calc(100% + 18px);
    left: -20px;
    width: 290px;
    padding: 10px;
    border: 1px solid rgba(11, 28, 75, 0.14);
    background: #fff;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms;
  }
  .nav-tools__menu::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 100%;
    height: 20px;
  }
  .nav-tools:is(:hover, :focus-within) .nav-tools__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-tools__menu a {
    display: block;
    padding: 12px 10px;
    color: #0b1c4b;
    line-height: 1.45;
    text-decoration: none;
  }
  .nav-tools__menu a:hover {
    background: #f4f6f9;
  }
  .nav > a:not(.contact)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -7px;
    height: 2px;
    background: #0a72c8;
    transition: right 0.2s;
  }
  .nav > a:hover::after {
    right: 0;
  }
  .contact {
    display: flex;
    gap: 10px;
    align-items: center;
    background: #0a72c8;
    color: #fff !important;
    padding: 12px 20px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .language {
    font-weight: 700;
  }
  .menu-button {
    display: none;
    border: 0;
    background: none;
    padding: 8px;
  }
  .menu-button span:not(.sr-only) {
    display: block;
    width: 24px;
    height: 2px;
    background: #0b1c4b;
    margin: 5px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .nav-backdrop {
    display: none;
  }
  :global(body.nav-locked) {
    overflow: hidden;
  }
  @media (max-width: 1300px) {
    .brand img {
      width: 210px;
    }
    .nav {
      gap: 18px;
    }
    .contact {
      padding: 11px 14px;
    }
  }
  @media (max-width: 1024px) {
    .header__inner {
      height: 72px;
    }
    .menu-button {
      display: block;
      margin-left: auto;
    }
    .nav-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 60;
      border: 0;
      padding: 0;
      background: rgba(7, 18, 51, 0.5);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 260ms ease,
        visibility 260ms;
    }
    .nav-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }
    .nav {
      position: fixed;
      z-index: 61;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(86vw, 380px);
      height: 100dvh;
      margin: 0;
      background: #fff;
      padding: 96px 28px 32px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      font-size: 1.15rem;
      overflow-y: auto;
      box-shadow: none;
      transform: translateX(100%);
      transition:
        transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 320ms ease;
    }
    .nav.is-open {
      transform: translateX(0);
      box-shadow: -18px 0 48px rgba(7, 18, 51, 0.18);
    }
    .nav > a {
      padding: 14px 4px;
      border-bottom: 1px solid rgba(11, 28, 75, 0.1);
    }
    .nav-tools {
      border-bottom: 1px solid rgba(11, 28, 75, 0.1);
    }
    .nav-tools > a {
      display: block;
      padding: 14px 4px;
      font-weight: 600;
    }
    .nav-tools__menu {
      position: static;
      width: auto;
      padding: 0 0 10px 14px;
      border: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      font-size: 1rem;
    }
    .nav-tools__menu::before {
      display: none;
    }
    .nav-tools__menu a {
      padding: 10px 4px;
      color: rgba(11, 28, 75, 0.72);
    }
    .language {
      padding: 14px 4px;
    }
    .contact {
      justify-content: center;
      margin-top: 14px;
      padding: 16px;
      font-size: 1rem;
    }
    .brand img {
      width: 200px;
    }
  }
</style>
