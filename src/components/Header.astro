---
import Icon from './Icon.astro';
import '@/styles/components/Header.scss';
const { lang = 'vi' } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const labels =
  lang === 'en'
    ? ['Home', 'About', 'Services', 'Projects', 'Insights']
    : ['Trang chủ', 'Giới thiệu', 'Dịch vụ', 'Dự án', 'Bài viết'];
const paths = ['/', '/gioi-thieu/', '/dich-vu/', '/du-an/', '/bai-viet/'];
const links = paths.map((path, index) => [labels[index], `${base}${path}`]);
const contactLabel = lang === 'en' ? 'Contact us' : 'Liên hệ chúng tôi';
const switchHref =
  lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : `/en${Astro.url.pathname}`;
---

<header class="header">
  <div class="container header__inner">
    <a href={`${base}/`} class="brand">
      <img src="/logo-lasan.svg" width="250" height="35" alt="Lasan Marine" />
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span><span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main navigation">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <div class="nav-tools">
        <a href={`${base}/cong-cu/chuyen-doi-cong-suat/`}>
          {lang === 'en' ? 'Tools' : 'Công cụ'}
        </a>
        <div class="nav-tools__menu">
          <a href={`${base}/cong-cu/chuyen-doi-cong-suat/`}>
            {lang === 'en' ? 'Power conversion' : 'Chuyển đổi công suất'}
          </a>
          <a href={`${base}/cong-cu/kiem-tra-duong-kinh-truc-chan-vit/`}>
            {lang === 'en' ? 'Propeller shaft diameter check' : 'Kiểm tra đường kính trục chân vịt'}
          </a>
        </div>
      </div>
      <a href={switchHref} class="language" hreflang={lang === 'en' ? 'vi' : 'en'}>
        {lang === 'en' ? 'VI' : 'EN'}
      </a>
      <a href={`${base}/lien-he/`} class="contact">
        {contactLabel}
        <Icon name="arrow" size={18} />
      </a>
    </nav>
    <button class="nav-backdrop" type="button" tabindex="-1" aria-hidden="true"></button>
  </div>
</header>
<script>
  import { initHeaderNav } from '@/scripts/header-nav';
  initHeaderNav();
</script>
