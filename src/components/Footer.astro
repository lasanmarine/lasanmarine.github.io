---
import ContactMap from './ContactMap.astro';

const { lang = 'vi' } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const copy =
  lang === 'en'
    ? {
        description:
          'Marine engineering consultancy and design for fishing vessels, inland waterway vessels, and waterway transport.',
        menu: ['Home', 'About', 'Services', 'Projects', 'Insights'],
        services: 'Services',
        serviceLinks: [
          'New vessel design',
          'Hull conversion',
          'Vessel refit',
          'Technical documents',
        ],
        contact: 'Contact',
        tax: 'Tax code',
        address: '03 Tran Lu Street, Bac Nha Trang Ward, Khanh Hoa Province, Vietnam',
      }
    : {
        description:
          'Đơn vị tư vấn và thiết kế kỹ thuật chuyên về tàu đánh cá, phương tiện thủy nội địa và phương tiện vận tải đường thủy.',
        menu: ['Trang chủ', 'Giới thiệu', 'Dịch vụ', 'Dự án', 'Bài viết'],
        services: 'Dịch vụ',
        serviceLinks: ['Thiết kế tàu mới', 'Chuyển hoán vỏ', 'Hoán cải', 'Hồ sơ kỹ thuật'],
        contact: 'Liên hệ',
        tax: 'MST',
        address: 'Số 03 Trần Lư, Phường Bắc Nha Trang, Tỉnh Khánh Hòa, Việt Nam',
      };
const menuPaths = ['/', '/gioi-thieu/', '/dich-vu/', '/du-an/', '/bai-viet/'];
---

<footer class="border-t border-navy/14 bg-white text-ink/68">
  <div
    class="container grid grid-cols-[minmax(300px,0.8fr)_minmax(0,1.6fr)] gap-[clamp(64px,9vw,140px)] py-[72px] pb-12 max-[900px]:grid-cols-1 max-[900px]:gap-12 max-[520px]:pt-14 max-[520px]:pb-0"
  >
    <div class="flex items-start">
      <img
        src="/footer-logo.svg"
        width="372"
        height="138"
        alt="Lasan Marine"
        class="h-auto w-[min(100%,420px)] max-[900px]:w-[min(100%,340px)]"
      />
    </div>
    <div class="flex flex-col gap-11 pt-2">
      <p class="m-0 max-w-[680px] text-base leading-[1.7]">{copy.description}</p>
      <div class="grid grid-cols-[0.8fr_1fr_1.4fr] gap-10 max-[520px]:grid-cols-1 max-[520px]:gap-8">
        <div>
          <h2 class="m-0 mb-5 text-[17px] text-navy">Menu</h2>
          {
            copy.menu.map((label, index) => (
              <a
                href={`${base}${menuPaths[index]}`}
                class="mb-2.5 block w-fit text-sm leading-relaxed text-navy/70 no-underline transition-colors duration-[180ms] hover:text-marine"
              >
                {label}
              </a>
            ))
          }
        </div>
        <div>
          <h2 class="m-0 mb-5 text-[17px] text-navy">{copy.services}</h2>
          {
            copy.serviceLinks.map((label) => (
              <a
                href={`${base}/dich-vu/thiet-ke-tau-moi/`}
                class="mb-2.5 block w-fit text-sm leading-relaxed text-navy/70 no-underline transition-colors duration-[180ms] hover:text-marine"
              >
                {label}
              </a>
            ))
          }
        </div>
        <div>
          <h2 class="m-0 mb-5 text-[17px] text-navy">{copy.contact}</h2>
          <strong class="mb-2.5 block text-[15px] leading-relaxed text-navy">
            LASAN MARINE COMPANY LIMITED
          </strong>
          <span class="mb-2.5 block text-sm leading-relaxed">{copy.tax}: 4202063521</span>
          <span class="mb-2.5 block text-sm leading-relaxed">{copy.address}</span>
          <a
            href="tel:0834310781"
            class="mb-2.5 block w-fit text-sm leading-relaxed text-navy/70 no-underline transition-colors duration-[180ms] hover:text-marine"
          >
            0834 310 781
          </a>
        </div>
      </div>
      <ContactMap lang={lang} />
    </div>
  </div>
  <div class="container border-t border-navy/14 py-5 pb-9 text-[13px] text-navy/68 max-[520px]:mt-10">
    © 2026 Lasan Marine Company Limited.
  </div>
</footer>
