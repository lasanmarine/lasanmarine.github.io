---
const { lang = 'vi' } = Astro.props;
const address = '03 Trần Lư, Phường Bắc Nha Trang, Khánh Hòa, Việt Nam';
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const title = lang === 'en' ? 'Lasan Marine location map' : 'Bản đồ vị trí Lasan Marine';
const linkLabel = lang === 'en' ? 'Open in Google Maps' : 'Mở trên Google Maps';
---

<div class="contact-map relative border-y border-navy/16">
  <iframe
    src={mapUrl}
    title={title}
    width="600"
    height="360"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="block h-[clamp(320px,42vw,520px)] w-full border-0 [filter:saturate(0.75)_contrast(1.04)]"
  >
  </iframe>
  <a
    href={directionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block border-t border-navy/14 px-4 py-3 text-sm font-semibold text-marine no-underline"
  >
    {linkLabel}
  </a>
</div>
