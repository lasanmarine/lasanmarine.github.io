---
import ButtonLink from './ButtonLink.astro';
const { title, text = '', href = '/lien-he/', label = 'Liên hệ' } = Astro.props;
---

<section class="technical-grid cta">
  <div class="container">
    <div><h2>{title}</h2>{text && <p>{text}</p>}</div><ButtonLink href={href}>{label}</ButtonLink>
  </div>
</section>
<style lang="scss">
  .cta {
    color: white;
  }
  .cta .container {
    padding-block: 90px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
  }
  .cta h2 {
    font-size: clamp(2rem, 4vw, 2.875rem);
    line-height: 1.1;
    margin: 0;
    max-width: 850px;
  }
  .cta p {
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 17px;
  }
  @media (max-width: 700px) {
    .cta .container {
      grid-template-columns: 1fr;
      padding-block: 64px;
      gap: 32px;
    }
    .cta .button {
      justify-self: start;
    }
  }
</style>
