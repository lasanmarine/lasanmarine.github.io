---
import Icon from './Icon.astro';
// `outline` is the light-on-dark variant; `ghost` is its counterpart for
// light backgrounds.
const { href, outline = false, ghost = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['button', { 'button--outline': outline, 'button--ghost': ghost }, className]}
>
  <slot /><Icon name="arrow" />
</a>
