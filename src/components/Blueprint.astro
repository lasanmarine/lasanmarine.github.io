---
const { class: className = '', label = '', ...rest } = Astro.props;
---

<div class:list={['blueprint', className]} {...rest}>
  <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br">
  </i>
  <slot><span class="blueprint__label">{label}</span></slot>
</div>
