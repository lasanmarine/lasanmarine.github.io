---
interface FilterField {
  key: string;
  label: string;
  placeholder: string;
}

interface EngineRow {
  hang: string;
  hieu_may: string;
  ps: string;
  hp: string;
  kw: string;
  rpm: string;
}

interface Props {
  fields: FilterField[];
  headers: string[];
  sortLabel: string;
  emptyMessage: string;
  resultCountLabel: string;
  paginationLabel: string;
  prevLabel: string;
  nextLabel: string;
  note: string[];
  rows: EngineRow[];
}

const {
  fields,
  headers,
  sortLabel,
  emptyMessage,
  resultCountLabel,
  paginationLabel,
  prevLabel,
  nextLabel,
  note,
  rows,
} = Astro.props as Props;
---

<div
  class="block-engine-lookup lookup"
  data-aos="fade-up"
  data-engine-lookup
  data-rows={JSON.stringify(rows)}
  data-headers={JSON.stringify(headers)}
  data-sort-label={sortLabel}
>
  <div class="lookup-controls">
    {
      fields.map((field) => (
        <label>
          {field.label}
          <input type="text" placeholder={field.placeholder} data-filter={field.key} />
        </label>
      ))
    }
  </div>

  <div class="lookup-meta">
    <p class="lookup-count" data-count data-suffix={resultCountLabel} aria-live="polite"></p>
    <label class="lookup-sort">
      {sortLabel}
      <select data-sort-select>
        {headers.map((header, index) => <option value={index}>{header}</option>)}
      </select>
      <button type="button" data-sort-direction aria-label={sortLabel}>
        <span class="sort-arrow" aria-hidden="true"></span>
      </button>
    </label>
  </div>

  <div class="lookup-table-wrap">
    <table class="result-table">
      <thead>
        <tr>
          {
            headers.map((header, index) => (
              <th aria-sort="none" data-sort-index={index}>
                <button type="button" title={`${sortLabel}: ${header}`}>
                  {header}
                  <span class="sort-arrow" aria-hidden="true" />
                </button>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody data-body></tbody>
    </table>
    <p class="lookup-empty" data-empty hidden>{emptyMessage}</p>
  </div>

  <nav class="lookup-pagination" data-pagination aria-label={paginationLabel}>
    <button type="button" class="lookup-page-btn" data-prev aria-label={prevLabel}>‹</button>
    <div class="lookup-page-numbers" data-page-numbers></div>
    <button type="button" class="lookup-page-btn" data-next aria-label={nextLabel}>›</button>
  </nav>

  {note.map((paragraph) => <p class="tool-note">{paragraph}</p>)}
</div>

<script>
  import { initEngineLookup } from '@/scripts/engine-lookup-tool';
  initEngineLookup();
</script>
