---
import FormulaNote from '@/blocks/FormulaNote.astro';

interface FormulaNoteProps {
  title: string;
  steps: { tex: string; text: string }[];
  termsTitle: string;
  terms: { tex: string; text: string }[];
}

interface MaterialOption {
  value: string;
  label: string;
  k3: string;
}

interface Props {
  powerLabel: string;
  unitLabel: string;
  units: string[];
  rpmLabel: string;
  ratioLabel: string;
  ratioPlaceholder: string;
  materialLabel: string;
  materials: MaterialOption[];
  submitLabel: string;
  resetLabel: string;
  resultHeaders: string[];
  resultRows: { label: string; unit: string; key: string }[];
  note: string;
  formula: FormulaNoteProps;
}

const {
  powerLabel,
  unitLabel,
  units,
  rpmLabel,
  ratioLabel,
  ratioPlaceholder,
  materialLabel,
  materials,
  submitLabel,
  resetLabel,
  resultHeaders,
  resultRows,
  note,
  formula,
} = Astro.props as Props;
---

<div class="block-shaft-diameter-calculator calculator" data-shaft-calculator data-aos="fade-up">
  <form class="calculator-form" novalidate>
    <div class="calculator-fields">
      <label>
        {powerLabel}
        <input type="number" name="power" min="0" step="any" inputmode="decimal" required />
      </label>
      <fieldset class="unit-choice">
        <legend>{unitLabel}</legend>
        <div class="unit-choice__options">
          {
            units.map((unit, index) => (
              <label>
                <input type="radio" name="unit" value={unit} checked={index === 0} />
                <span>{unit}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <label>
        {rpmLabel}
        <input type="number" name="rpm" min="0" step="any" inputmode="decimal" required />
      </label>
      <label>
        {ratioLabel}
        <input
          type="number"
          name="ratio"
          min="0"
          step="any"
          inputmode="decimal"
          placeholder={ratioPlaceholder}
          required
        />
      </label>
      <fieldset class="material-choice full">
        <legend>{materialLabel}</legend>
        <div class="material-choice__options">
          {
            materials.map((material, index) => (
              <label>
                <input type="radio" name="k3" value={material.value} checked={index === 0} />
                <span>
                  <strong>{material.label}</strong>
                  <em>
                    K<sub>3</sub> = {material.k3}
                  </em>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>
    <p class="calculator-error" data-error hidden></p>
    <div class="calculator-actions">
      <button class="button" type="submit">{submitLabel}</button>
      <button class="button button--secondary" type="reset">{resetLabel}</button>
    </div>
  </form>

  <div class="calculator-result" data-results hidden aria-live="polite">
    <table class="result-table">
      <thead>
        <tr>
          <th>{resultHeaders[0]}</th>
          <th>{resultHeaders[1]}</th>
          <th>{resultHeaders[2]}</th>
        </tr>
      </thead>
      <tbody>
        {
          resultRows.map((row) => (
            <tr>
              <td>{row.label}</td>
              <td data-result={row.key} />
              <td>{row.unit}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <FormulaNote
      title={formula.title}
      steps={formula.steps}
      termsTitle={formula.termsTitle}
      terms={formula.terms}
      note={note}
    />
  </div>
</div>

<script>
  import { initShaftDiameterTool } from '@/scripts/shaft-diameter-tool';
  initShaftDiameterTool();
</script>
