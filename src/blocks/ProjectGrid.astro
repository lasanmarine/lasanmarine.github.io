---
import Blueprint from '@/components/Blueprint.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  base: string;
  projects: { name: string; service: string; group: string; meta: string }[];
  imageLabel: string;
  limit?: number;
}

const { base, projects, imageLabel, limit } = Astro.props as Props;
const visibleProjects = projects.slice(0, limit ?? projects.length);
---

<div
  class="block-project-grid grid grid-cols-3 gap-x-9 gap-y-12 max-[850px]:grid-cols-2 max-[550px]:grid-cols-1"
>
  {
    visibleProjects.map((p, index) => (
      <a
        class="group grid grid-rows-[auto_auto_auto_1fr] content-start gap-3 no-underline"
        href={`${base}/du-an/tau-ca-vo-thep-24m/`}
        data-group={p.group}
        data-aos="fade-up"
        data-aos-delay={(index % 3) * 90}
      >
        <Blueprint
          class="mb-2 aspect-4/3 transition-transform duration-300 group-hover:-translate-y-1.5"
          label={imageLabel}
        />
        <b class="text-[15px] leading-[1.4] text-marine">{p.service}</b>
        <h3 class="m-0 min-h-[2.3em] text-[26px] leading-[1.15] text-navy transition-colors duration-200 group-hover:text-marine max-[550px]:min-h-0">
          {p.name}
        </h3>
        <div class="mt-1 flex items-start justify-between gap-4 border-t border-navy/14 pt-4 text-sm leading-[1.55] text-ink/72">
          <span>{p.meta}</span>
          <Icon
            name="arrow"
            class="flex-none text-marine transition-transform duration-200 group-hover:translate-x-1.5"
          />
        </div>
      </a>
    ))
  }
</div>
