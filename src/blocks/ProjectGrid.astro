---
import Blueprint from '@/components/Blueprint.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  base: string;
  projects: { name: string; service: string; group: string; meta: string }[];
  imageLabel: string;
  limit?: number;
}

const { base, projects, imageLabel, limit } = Astro.props as Props;
const visibleProjects = projects.slice(0, limit ?? projects.length);
---

<div class="grid grid-cols-3 gap-x-9 gap-y-12 max-[850px]:grid-cols-2 max-[550px]:grid-cols-1">
  {
    visibleProjects.map((p) => (
      <a
        class="grid grid-rows-[auto_auto_auto_1fr] content-start gap-3 no-underline"
        href={`${base}/du-an/tau-ca-vo-thep-24m/`}
        data-group={p.group}
      >
        <Blueprint class="mb-2 aspect-4/3" label={imageLabel} />
        <b class="text-[15px] leading-[1.4] text-marine">{p.service}</b>
        <h3 class="m-0 min-h-[2.3em] text-[26px] leading-[1.15] text-navy max-[550px]:min-h-0">
          {p.name}
        </h3>
        <div class="mt-1 flex items-start justify-between gap-4 border-t border-navy/14 pt-4 text-sm leading-[1.55] text-ink/72">
          <span>{p.meta}</span>
          <Icon name="arrow" class="flex-none text-marine" />
        </div>
      </a>
    ))
  }
</div>
