---
interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props as Props;
---

<section class="technical-grid text-white">
  <div class="container py-[110px] max-[600px]:py-18">
    <h1 class="page-title m-0 max-w-[950px]">{title}</h1>
    {
      description && (
        <p class="mt-[26px] mb-0 max-w-[760px] text-[19px] leading-[1.65] text-white/72 max-[600px]:text-[17px]">
          {description}
        </p>
      )
    }
  </div>
</section>
