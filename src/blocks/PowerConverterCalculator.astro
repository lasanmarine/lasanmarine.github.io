---
import FormulaNote from '@/blocks/FormulaNote.astro';

interface FormulaNoteProps {
  title: string;
  steps: { tex: string; text: string }[];
  termsTitle: string;
  terms: { tex: string; text: string }[];
}

interface Props {
  valueLabel: string;
  valuePlaceholder: string;
  unitLabel: string;
  units: string[];
  submitLabel: string;
  resetLabel: string;
  resultHeaders: string[];
  resultUnits: { key: string; label: string }[];
  note: string;
  formula: FormulaNoteProps;
}

const {
  valueLabel,
  valuePlaceholder,
  unitLabel,
  units,
  submitLabel,
  resetLabel,
  resultHeaders,
  resultUnits,
  note,
  formula,
} = Astro.props as Props;
---

<div class="block-power-converter-calculator calculator" data-power-converter data-aos="fade-up">
  <form class="calculator-form" novalidate>
    <div class="calculator-fields">
      <label>
        {valueLabel}
        <input
          type="number"
          name="value"
          min="0"
          step="any"
          inputmode="decimal"
          placeholder={valuePlaceholder}
          required
        />
      </label>
      <fieldset class="unit-choice">
        <legend>{unitLabel}</legend>
        <div class="unit-choice__options">
          {
            units.map((unit, index) => (
              <label>
                <input type="radio" name="unit" value={unit} checked={index === 0} />
                <span>{unit}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>
    <p class="calculator-error" data-error hidden></p>
    <div class="calculator-actions">
      <button class="button" type="submit">{submitLabel}</button>
      <button class="button button--secondary" type="reset">{resetLabel}</button>
    </div>
  </form>

  <div class="calculator-result" data-results hidden aria-live="polite">
    <table class="result-table">
      <thead>
        <tr>
          <th>{resultHeaders[0]}</th>
          <th>{resultHeaders[1]}</th>
          <th>{resultHeaders[2]}</th>
        </tr>
      </thead>
      <tbody>
        {
          resultUnits.map((unit) => (
            <tr>
              <td data-result={unit.key} />
              <td data-rounded={unit.key} />
              <td>{unit.label}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <FormulaNote
      title={formula.title}
      steps={formula.steps}
      termsTitle={formula.termsTitle}
      terms={formula.terms}
      note={note}
    />
  </div>
</div>

<script>
  import { initPowerConversionTool } from '@/scripts/power-conversion-tool';
  initPowerConversionTool();
</script>
