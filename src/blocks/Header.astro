---
import Icon from '@/components/Icon.astro';
import '@/styles/components/Header.scss';

interface Props {
  base: string;
  content: {
    links: string[][];
    toolsLabel: string;
    toolsMenu: { label: string; href: string; description: string; icon: string }[];
    contactLabel: string;
    languages: string[][];
  };
}

const { base, content } = Astro.props as Props;
const currentLang = base === '/en' ? 'en' : 'vi';
const localizedPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const languageHref = (lang: string) => (lang === 'en' ? `/en${localizedPath}` : localizedPath);
const currentLanguageLabel =
  content.languages.find(([, lang]) => lang === currentLang)?.[0] ?? content.languages[0][0];
---

<header class="block-header header">
  <div class="container header__inner">
    <a href={`${base}/`} class="brand">
      <img src="/logo-lasan.svg" width="250" height="35" alt="Lasan Marine" />
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span><span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main navigation">
      {content.links.map(([label, path]) => <a href={`${base}${path}`}>{label}</a>)}
      <div class="nav-tools">
        <a href={`${base}/cong-cu/chuyen-doi-cong-suat/`}>{content.toolsLabel}</a>
        <div class="nav-tools__menu">
          {
            content.toolsMenu.map((tool) => (
              <a class="tool-card" href={`${base}${tool.href}`}>
                <span class="tool-card__top">
                  <Icon name={tool.icon} size={34} class="tool-card__icon" />
                  <Icon name="arrow-up-right" size={18} class="tool-card__arrow" />
                </span>
                <strong>{tool.label}</strong>
                <span class="tool-card__text">{tool.description}</span>
              </a>
            ))
          }
        </div>
      </div>
      <a class="nav-contact" href={`${base}/lien-he/`}>{content.contactLabel}</a>
      <div class="nav-language">
        <button class="nav-language__toggle" type="button" aria-expanded="false">
          {currentLanguageLabel}
          <Icon name="chevron-down" size={16} />
        </button>
        <div class="nav-language__menu">
          {
            content.languages.map(([label, lang]) => (
              <a
                href={languageHref(lang)}
                hreflang={lang}
                lang={lang}
                aria-current={lang === currentLang ? 'true' : undefined}
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
    <button class="nav-backdrop" type="button" tabindex="-1" aria-hidden="true"></button>
  </div>
</header>
<script>
  import { initHeaderNav } from '@/scripts/header-nav';
  initHeaderNav();
</script>
