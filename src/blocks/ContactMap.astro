---
interface Props {
  content: {
    title: string;
    linkLabel: string;
  };
}

const { content } = Astro.props as Props;
const address = '03 Trần Lư, Phường Bắc Nha Trang, Khánh Hòa, Việt Nam';
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<div class="block-contact-map contact-map relative border-y border-navy/16" data-aos="fade-up">
  <iframe
    src={mapUrl}
    title={content.title}
    width="600"
    height="360"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="block h-[clamp(320px,42vw,520px)] w-full border-0 [filter:saturate(0.75)_contrast(1.04)]"
  >
  </iframe>
  <a
    href={directionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block border-t border-navy/14 px-4 py-3 text-sm font-semibold text-marine no-underline transition-colors duration-200 hover:bg-pale"
  >
    {content.linkLabel}
  </a>
</div>
